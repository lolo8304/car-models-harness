# Copy to .env in the repository root. Never commit the real .env.
# The CLI loads .env from its current working directory.
# Shell environment variables take precedence over file values.
VEHICLE_MOCK=0
VEHICLE_CATALOG_URL=http://127.0.0.1:4010
VEHICLE_INSURED_URL=http://127.0.0.1:4011

# From your Clerk OAuth PUBLIC application (not the publishable/secret API keys).
CLERK_OAUTH_ISSUER=
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_SCOPES="openid profile"
# CLERK_OAUTH_AUDIENCE=

# Defaults use your OS credential store. Explicit POSIX file fallback:
# VEHICLE_CREDENTIAL_STORE=file
# VEHICLE_CREDENTIAL_FILE=/absolute/private/directory/credentials.json
# VEHICLE_TIMEOUT_MS=10000
# VEHICLE_LOGIN_TIMEOUT_MS=180000

# Register http://127.0.0.1:8765/callback in Clerk Redirect URIs.
CLERK_OAUTH_CALLBACK_PORT=8765
